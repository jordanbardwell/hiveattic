{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hiveattic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "workers_dev": false,
  "routes": [{ "pattern": "hiveattic.com", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "VAULT_PREFIX": "vault/",
    "TZ_DISPLAY": "UTC",
    "RATE_LIMIT_WRITES_PER_MIN": "60",
    "RATE_LIMIT_READS_PER_MIN": "300",
    "E2E_CLEANUP_ENABLED": "",
    "DEPLOY_ENV": "",
    "VAULT_BUCKET": "hiveattic-vault",
    "DB_NAME": "hiveattic-index",
    "WORKER_NAME": "hiveattic"
  },
  "triggers": { "crons": ["15 7 * * *"] },
  "secrets": { "required": ["TOKEN_PEPPER", "ADMIN_TOKEN_HASH", "AUDIT_KEY", "JOURNAL_MAC_KEY"] },
  "r2_buckets": [{ "binding": "VAULT", "bucket_name": "hiveattic-vault" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiveattic-index",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "WRITER", "class_name": "VaultWriter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultWriter"] }],
  "queues": {
    "producers": [{ "binding": "INDEX_Q", "queue": "hiveattic-index-jobs" }],
    "consumers": [
      {
        "queue": "hiveattic-index-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "hiveattic-index-dlq"
      }
    ]
  }
}
