{
  "name": "hiveattic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  },
  "description": "HiveAttic is a shared cross-agent memory vault. Markdown in R2 is the source of truth. D1 is the rebuildable index.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types e2e/dry-run.check.ts && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "e2e": "node --experimental-strip-types e2e/run.ts",
    "provision": "node --experimental-strip-types scripts/provision-pilot.ts",
    "mint-reviewer": "node --experimental-strip-types scripts/mint-reviewer.ts",
    "hash-token": "node --experimental-strip-types scripts/hash-token.ts",
    "rebuild": "node --experimental-strip-types scripts/rebuild-from-r2.ts",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "node --experimental-strip-types scripts/deploy.ts"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "Your admin password, at least 16 characters. You sign in to /console with it. Keep it somewhere safe."
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
