TOKEN_PEPPER=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-an-admin-password-of-16-characters-or-more
AUDIT_KEY=replace-with-another-long-random-string
JOURNAL_MAC_KEY=replace-with-a-different-long-random-string
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_READS_PER_MIN=300
# IANA zone for journal day files and headings. The code default is UTC. Staging uses America/New_York.
VAULT_TZ=UTC
# Domain classes. A domain in neither list is refused on write and read as sensitive.
SENSITIVE_DOMAINS=health,finance
ORDINARY_DOMAINS=deals,x
# Where text whose only sensitive part is a phone number, street address, or date of birth goes:
# restricted (the default, admin-only sensitive/restricted/) or keep (where it was written).
PII_ROUTE=restricted
