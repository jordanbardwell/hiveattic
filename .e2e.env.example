# Production is read-only smoke (HIVEATTIC_E2E_READ_ONLY=1). Writes run only against staging.
# Use the workers.dev URL. hiveattic.com is not attached yet.
HIVEATTIC_BASE_URL=
HIVEATTIC_ADMIN_TOKEN=
HIVEATTIC_REVIEWER_TOKEN=
# HIVEATTIC_E2E_READ_ONLY=1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=hiveattic-vault
HIVEATTIC_E2E_OUT=e2e-results/results.json
# Deployed writes-per-minute. 0 means the limit is disabled.
# T-06 sends 140 journal writes. Raise RATE_LIMIT_WRITES_PER_MIN before the run and restore 60 after. See the README.
# Required for every write, including T-01 through T-12. The harness refuses a non-staging target.
HIVEATTIC_STAGING_BASE_URL=
HIVEATTIC_STAGING_ADMIN_TOKEN=
# HIVEATTIC_RATE_LIMIT_WRITES_PER_MIN=10000
# Optional. Both values let the suite read the DLQ backlog. The token needs Queues read and Account Analytics read.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Staging writes default to hiveattic-staging-index-dlq.
# Read-only prod defaults to hiveattic-index-dlq. Set this to override either.
# HIVEATTIC_DLQ_NAME=hiveattic-staging-index-dlq
# Backlog is queueBacklogAdaptiveGroups avg.messages, then the queues metrics backlog_count.
