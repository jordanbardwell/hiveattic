# The live suite runs against staging only. It reads HIVEATTIC_STAGING_* names and no others, and it
# refuses to start if HIVEATTIC_BASE_URL, HIVEATTIC_ADMIN_TOKEN, HIVEATTIC_REVIEWER_TOKEN, or
# HIVEATTIC_E2E_READ_ONLY is set. Keep the filled-in copy outside the checkout.
# The base URL must be the hiveattic-staging workers.dev host over https.
HIVEATTIC_STAGING_BASE_URL=
HIVEATTIC_STAGING_ADMIN_TOKEN=
# Optional. Without it the suite mints a reviewer under a run-scoped agent id.
# HIVEATTIC_STAGING_REVIEWER_TOKEN=
HIVEATTIC_E2E_OUT=e2e-results/results.json
# T-11 needs an R2 S3 key scoped to the staging bucket. Every S3 call checks that R2_BUCKET is a
# hiveattic-staging-* bucket first. Leave all four unset to skip T-11.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=
# The deployed staging writes-per-minute, as Forge confirms it. 0 means the limit is disabled.
# T-06 sends 140 journal writes. Ask Forge to raise the limit before the run and restore 60 after.
# HIVEATTIC_RATE_LIMIT_WRITES_PER_MIN=140
# Optional. Both values let the suite read the staging DLQ backlog and Workers Logs. The token needs
# Queues read, Account Analytics read, and Workers Observability read.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# HIVEATTIC_DLQ_NAME=hiveattic-staging-index-dlq
# HIVEATTIC_WORKER_NAME=hiveattic-staging
# HIVEATTIC_STAGING_WRANGLER_CONFIG=wrangler.staging.example.jsonc
