HIVEATTIC_BASE_URL=https://hiveattic.<account>.workers.dev
HIVEATTIC_ADMIN_TOKEN=
HIVEATTIC_REVIEWER_TOKEN=
# HIVEATTIC_ACCOUNT_NUMBER=
# HIVEATTIC_ACCOUNT_FIXTURE=test/fixtures/account-number.local.txt
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=hiveattic-vault
HIVEATTIC_E2E_OUT=e2e-results/results.json
# Deployed writes-per-minute. 0 means the limit is disabled.
# T-06 sends 140 journal writes. Raise RATE_LIMIT_WRITES_PER_MIN before the run and restore 60 after. See the README.
# Staging worker for T-12 and cleanup. Do not point these at the production vault.
# HIVEATTIC_STAGING_BASE_URL=
# HIVEATTIC_STAGING_ADMIN_TOKEN=
# HIVEATTIC_RATE_LIMIT_WRITES_PER_MIN=10000
# Optional Workers Logs query. Both values are required before the suite reads logs.
# The API token needs Workers Observability Write. See the README for the wrangler tail procedure.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# HIVEATTIC_WORKER_NAME=hiveattic
# HIVEATTIC_LOG_WAIT_MS=15000
